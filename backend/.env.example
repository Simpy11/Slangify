PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173
PYTHON_SERVICE_URL=http://127.0.0.1:8001

# Gen Z Buzz uses public RSS feeds; no news API key is required.
# Backend cache in minutes (clamped to 30?60). Refresh never bypasses this cache.
NEWS_CACHE_MINUTES=45

# Keep longer than Gemini and shorter than the browser AI timeout.
PYTHON_SERVICE_TIMEOUT_MS=55000
